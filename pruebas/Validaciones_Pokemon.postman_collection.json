    {
      "name": "04 - Buscar ID 9999",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}{{rutaPokemon}}/9999",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "{{rutaPokemon}}",
            "9999"
          ]
        },
        "description": "Debe devolver 404 si el registro no existe."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Pokémon 9999 inexistente: HTTP 404\", () => {",
              "  pm.response.to.have.status(404);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - Pokémon válido",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}{{rutaPokemon}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "{{rutaPokemon}}"
          ]
        },
        "description": "Debe crear el Pokémon con datos válidos. Esperado 200 o 201.",
        "body": {
          "mode": "raw",
          "raw": "{{payloadPrueba}}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const raw = pm.collectionVariables.get(\"pokemonBaseJson\");",
              "let pokemon;",
              "try {",
              "  pokemon = JSON.parse(raw);",
              "} catch (error) {",
              "  throw new Error(\"Configura pokemonBaseJson como JSON válido: \" + error.message);",
              "}",
              "const correo = pm.collectionVariables.get(\"campoCorreo\");",
              "const nivel = pm.collectionVariables.get(\"campoNivel\");",
              "const fecha = pm.collectionVariables.get(\"campoFecha\");",
              "if (!correo || !nivel || !fecha) throw new Error(\"Configura campoCorreo, campoNivel y campoFecha\");",
              "pokemon[correo] = \"validaciones.ok.20261122@example.com\";",
              "pokemon[nivel] = 25;",
              "pokemon[fecha] = \"2026-11-20\";",
              "pm.variables.set(\"payloadPrueba\", JSON.stringify(pokemon, null, 2));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Creación exitosa HTTP 200 o 201\", () => {",
              "  pm.expect([200, 201]).to.include(pm.response.code);",
              "});",
              "try {",
              "  const response = pm.response.json();",
              "  if (response.id !== undefined) pm.collectionVariables.set(\"idCreado\", String(response.id));",
              "} catch (e) { /* La API puede devolver éxito sin JSON. */ }"
            ]
          }
        }
      ]
    }
  ]
}
